#!/usr/bin/env bash
# axc — клиент aixchange для агентов без клона хаба: команды xchg поверх HTTP API.
# Использование: axc <команда> [...]; `axc help` — список. Нужны bash ≥ 3.2 и curl.
set -euo pipefail

VERSION="0.5.9"
CONF_DIR="${AIXCHANGE_CONF_DIR:-$HOME/.config/aixchange}"
CONF="$CONF_DIR/config"
URL="" TOKEN="" DEFAULT_HUB=""
OPT_HUB="${AIXCHANGE_HUB:-}"
STATUS="" BODY=""
HOOK_EVENT=""

die()  { echo "axc: $*" >&2; exit 1; }
udie() { echo "axc: $*" >&2; exit 2; }
have() { command -v "$1" >/dev/null 2>&1; }

# --- конфиг: url, token, default ------------------------------------------------------------
load_conf() {
  [ -f "$CONF" ] || return 0
  local k v
  while IFS='=' read -r k v || [ -n "$k" ]; do
    k=$(printf '%s' "$k" | tr -d ' \t\r'); v=$(printf '%s' "${v:-}" | sed 's/^[ \t]*//; s/[ \t\r]*$//')
    case "$k" in url) URL="$v";; token) TOKEN="$v";; default) DEFAULT_HUB="$v";; esac
  done < "$CONF"
  return 0
}
require_conf() { [ -n "$URL" ] && [ -n "$TOKEN" ] || die "не подключено: axc connect <url> <токен>"; }
write_conf() {  # <url> <token> <default>
  mkdir -p "$CONF_DIR"; umask 077
  { echo "# aixchange — подключение к сервису (не в git)"; echo "url = $1"; echo "token = $2"; [ -z "$3" ] || echo "default = $3"; } > "$CONF"
  chmod 600 "$CONF" 2>/dev/null || true
}

# --- HTTP -------------------------------------------------------------------------------------
urlencode() {
  local LC_ALL=C s="$1" out="" i c
  for ((i = 0; i < ${#s}; i++)); do
    c="${s:i:1}"
    case "$c" in [a-zA-Z0-9.~_-]) out+="$c";; *) out+=$(printf '%%%02X' "$(( $(printf '%d' "'$c") & 255 ))");; esac
  done
  printf '%s' "$out"
}
# api <метод> <путь с query> [аргументы curl...] → BODY, STATUS
api() {
  local method="$1" path="$2" out; shift 2
  out=$(curl -sS -X "$method" -H "Authorization: Bearer $TOKEN" -H "Accept: text/plain" -w '\n%{http_code}' "$@" "$URL$path") \
    || die "нет связи с $URL"
  STATUS="${out##*$'\n'}"; BODY="${out%$'\n'*}"
  [ "$out" = "$STATUS" ] && BODY=""
  return 0
}
check() { case "$STATUS" in 2*) return 0;; *) [ -n "$BODY" ] && printf '%s\n' "$BODY" >&2 || echo "axc: HTTP $STATUS" >&2; exit 1;; esac; }
say()   { [ -z "$BODY" ] || printf '%s\n' "$BODY"; }

# --- хаб и проект сессии -------------------------------------------------------------------------
HUBS=""
hubs_list() { [ -n "$HUBS" ] && return 0; api GET /v1/hubs; check; HUBS=$(printf '%s\n' "$BODY" | awk 'NF {print $1}'); return 0; }
is_hub() { hubs_list; printf '%s\n' "$HUBS" | grep -qx -- "$1"; }
hub_count() { hubs_list; printf '%s\n' "$HUBS" | grep -c . || true; }
# split_addr <адрес> → A_HUB, A_ADDR: префикс хаба отделяется, если это известный хаб
A_HUB="" A_ADDR=""
split_addr() {
  local spec="$1" first="${1%%:*}"
  A_HUB="" A_ADDR="$spec"
  if [ "$first" != "$spec" ] && is_hub "$first"; then A_HUB="$first"; A_ADDR="${spec#*:}"; fi
  [ -n "$A_HUB" ] || A_HUB="$OPT_HUB"
  [ -n "$A_HUB" ] || A_HUB="$DEFAULT_HUB"
  if [ -z "$A_HUB" ]; then
    if [ "$(hub_count)" = 1 ]; then A_HUB="$HUBS"; else die "несколько хабов ($(printf '%s' "$HUBS" | tr '\n' ' ')): укажи префикс, например ${HUBS%%$'\n'*}:$spec, или default в $CONF"; fi
  fi
}
# hub_for_file <файл> → A_HUB и F_NAME: «хаб:путь», путь или имя
F_NAME=""
hub_for_file() {
  local spec="$1" first="${1%%:*}"
  A_HUB="" F_NAME="$spec"
  if [ "$first" != "$spec" ] && is_hub "$first"; then A_HUB="$first"; F_NAME="${spec#*:}"; fi
  F_NAME="${F_NAME##*/}"
  [ -n "$A_HUB" ] || A_HUB="$OPT_HUB"
  [ -n "$A_HUB" ] || A_HUB="$DEFAULT_HUB"
  if [ -z "$A_HUB" ]; then
    if [ "$(hub_count)" = 1 ]; then A_HUB="$HUBS"; else die "несколько хабов: укажи файл как <хаб>:<имя> или default в $CONF"; fi
  fi
}
repo_root() { local common; common=$(git rev-parse --git-common-dir 2>/dev/null) || return 1; common=$(cd "$common" 2>/dev/null && pwd -P) || return 1; dirname "$common"; }
cur_project() {
  local root o; root=$(repo_root) || return 0
  o=$(git -C "$root" config --get xchg.project 2>/dev/null || true)
  [ -n "$o" ] || o=$(git -C "$root" config --get aixchange.project 2>/dev/null || true)
  echo "${o:-$(basename "$root")}"
}
project_norm() { printf '%s' "$1" | LC_ALL=C tr 'A-Z' 'a-z' | LC_ALL=C sed 's/[^a-z0-9._-]/-/g; s/--*/-/g; s/^-//; s/-$//'; }
project_q() { local p; p=$(cur_project); [ -n "$p" ] && printf '&project=%s' "$(urlencode "$p")" || true; }
hub_q() { [ -n "${1:-}" ] && printf '&hub=%s' "$(urlencode "$1")" || true; }
read_hook_input() {  # хук Claude Code подаёт JSON на stdin
  [ -t 0 ] && return 0
  local j=""; IFS= read -r -t 1 -d '' j || true
  HOOK_EVENT=$(printf '%s' "$j" | sed -n 's/.*"hook_event_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
  return 0
}

# --- команды ------------------------------------------------------------------------------------
cmd_connect() {
  local url="${1:-}" token="" code="" name="" def=""
  [ -n "$url" ] || udie "connect <url> <токен> | connect <url> --code ABCD-1234 [--name устройство] [--default хаб]"
  shift
  case "${1:-}" in --*|"") ;; *) token="$1"; shift;; esac
  while [ $# -gt 0 ]; do case "$1" in
    --code) code="$2"; shift 2;; --name) name="$2"; shift 2;; --default) def="$2"; shift 2;;
    *) udie "connect: неизвестный флаг $1";; esac; done
  url="${url%/}"; URL="$url"
  if [ -n "$code" ]; then
    [ -n "$name" ] || name="$(hostname 2>/dev/null || echo agent)"
    TOKEN="none"
    api POST "/v1/pair?code=$(urlencode "$code")&device_name=$(urlencode "$name")"; check
    token="${BODY%%$'\n'*}"
  fi
  [ -n "$token" ] || udie "нужен токен или --code"
  TOKEN="$token"
  api GET /v1/me; check
  write_conf "$url" "$token" "$def"
  echo "подключено: $url"; say
  echo "конфиг: $CONF"
}
cmd_status() {
  echo "axc $VERSION; конфиг $CONF; url ${URL:-—}; default ${DEFAULT_HUB:-—}; проект здесь: $(cur_project 2>/dev/null || echo —)"
  [ -n "$URL" ] && [ -n "$TOKEN" ] || return 0
  api GET /v1/me; check; say
}
cmd_hubs() { require_conf; api GET /v1/hubs; check; say; }
cmd_hub() {
  require_conf; local slug="${1:-$OPT_HUB}"; [ -n "$slug" ] || slug="$DEFAULT_HUB"
  if [ -z "$slug" ]; then if [ "$(hub_count)" = 1 ]; then slug="$HUBS"; else udie "hub <slug> — хабов несколько (axc hubs)"; fi; fi
  api GET "/v1/hubs/$(urlencode "$slug")"; check; say
}
# doctor: что не так с подключением — конфиг, сервер, токен, хабы, проект, PATH; код 1, если есть ✗.
cmd_doctor() {
  local bad=0 ok="✓" no="✗"
  echo "axc $VERSION · конфиг $CONF"
  if [ -z "$URL" ] || [ -z "$TOKEN" ]; then
    echo "$no не подключено: axc connect <url> <токен>  или  curl -fsSL <url>/pair/КОД/setup.sh | bash"; exit 1
  fi
  echo "$ok сервер $URL"
  local code; code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 10 "$URL/healthz" 2>/dev/null || echo 000)
  if [ "$code" = "200" ]; then echo "$ok связь: healthz 200"; else echo "$no нет связи с $URL (healthz $code): проверь адрес и сеть"; exit 1; fi
  api GET /v1/me
  case "$STATUS" in
    2*) echo "$ok токен: $(printf '%s' "$BODY" | head -1)";;
    401) echo "$no токен не принят (отозван?): выдай новый на странице «Устройства» и axc connect"; bad=1;;
    *) echo "$no /v1/me: HTTP $STATUS $BODY"; bad=1;;
  esac
  api GET /v1/hubs
  if [ "$STATUS" = "200" ] && [ -n "$BODY" ]; then
    echo "$ok хабы:"; printf '%s\n' "$BODY" | sed 's/^/    /'
    [ -n "$DEFAULT_HUB" ] && echo "$ok хаб по умолчанию: $DEFAULT_HUB" || { [ "$(printf '%s\n' "$BODY" | grep -c .)" -gt 1 ] && echo "· хабов несколько, default не задан: адреса и файлы с префиксом хаб: (axc connect … --default work)" || true; }
  else
    echo "$no хабов нет: тебя ещё никуда не пригласили"; bad=1
  fi
  local root p; root=$(repo_root 2>/dev/null || true)
  if [ -n "$root" ]; then
    p=$(cur_project); echo "$ok репозиторий $root → проект «$p»"
    api GET "/v1/agent?project=$(urlencode "$p")$(hub_q "$OPT_HUB")"
    if [ "$STATUS" = "200" ]; then echo "$ok агент: $(printf '%s' "$BODY" | head -1)"; else echo "$no проект «$p» не заведён в хабе: axc projects add"; bad=1; fi
  else
    echo "· не в git-репозитории: агент = человек × проект; зайди в репозиторий и axc projects add"
  fi
  local self; self=$(cd "$(dirname "$0")" && pwd)
  case ":$PATH:" in *":$self:"*) echo "$ok axc в PATH ($self)";; *) echo "· axc не в PATH: export PATH=\"$self:\$PATH\" (хукам плагина PATH не нужен)";; esac
  local srv; srv=$(curl -sS --max-time 10 "$URL/axc" 2>/dev/null | sed -n 's/^VERSION="\([^"]*\)"$/\1/p' | head -1)
  if [ -z "$srv" ]; then echo "· версия клиента на сервере не прочиталась ($URL/axc)"
  elif [ "$srv" = "$VERSION" ]; then echo "$ok клиент $VERSION — как на сервере"
  else echo "· клиент $VERSION, на сервере $srv — обнови: curl -fsSL $URL/axc -o \"$self/axc\" && chmod +x \"$self/axc\" (плагин Claude Code обновляется через /plugin)"; fi
  [ "$bad" = 0 ] && echo "всё в порядке" || exit 1
}
cmd_agent() { require_conf; local p; p=$(cur_project); [ -n "$p" ] || die "не в git-репозитории: агент — это человек × проект"
  api GET "/v1/agent?project=$(urlencode "$p")$(hub_q "$OPT_HUB")"; check; say; }
cmd_inbox() {
  require_conf; local brief=0 q=""
  while [ $# -gt 0 ]; do case "$1" in
    --brief) brief=1; shift;; --all) q="$q&all=1"; shift;; --history) q="$q&history=1"; shift;;
    --max-age) shift 2;; --hub) OPT_HUB="$2"; shift 2;;
    *) udie "inbox [--brief] [--all] [--history] [--hub H]";; esac; done
  if [ "$brief" = 1 ]; then
    read_hook_input
    if [ "$HOOK_EVENT" = SessionStart ]; then q="$q&scope=open"; else q="$q&scope=new"; fi
  fi
  api GET "/v1/inbox?x=1$q$(project_q)$(hub_q "$OPT_HUB")"
  case "$STATUS" in 204) return 0;; esac
  check; say
}
cmd_wait() {
  require_conf; local timeout=0 q=""
  while [ $# -gt 0 ]; do case "$1" in
    --timeout) timeout="$2"; shift 2;; --interval) shift 2;; --all) q="$q&all=1"; shift;; --hub) OPT_HUB="$2"; shift 2;;
    *) udie "wait [--timeout сек] [--hub H]";; esac; done
  [[ "$timeout" =~ ^[0-9]+$ ]] || udie "wait: --timeout — целые секунды"
  local left="$timeout"; [ "$left" -gt 0 ] || left=7200
  local start; start=$(date +%s)
  while :; do
    local chunk="$left"; [ "$chunk" -gt 3600 ] && chunk=3600
    api GET "/v1/inbox/wait?timeout=$chunk$q$(project_q)$(hub_q "$OPT_HUB")" --max-time $((chunk + 30))
    case "$STATUS" in
      200) say; return 0;;
      204) ;;
      *) check;;
    esac
    if [ "$timeout" -gt 0 ]; then
      left=$(( start + timeout - $(date +%s) ))
      [ "$left" -gt 0 ] || { echo "axc: за ${timeout} с новых сообщений нет" >&2; exit 3; }
    fi
  done
}
cmd_read()   { require_conf; [ -n "${1:-}" ] || udie "read <файл>"; hub_for_file "$1"; api GET "/v1/messages/$(urlencode "$F_NAME")?hub=$(urlencode "$A_HUB")" -H 'Accept: text/markdown'; check; say; }
cmd_attach() {
  require_conf; [ $# -ge 2 ] || udie "attach <хаб:файл> <путь> [--name имя]"
  local ref="$1" src="$2" name=""; shift 2
  while [ $# -gt 0 ]; do case "$1" in --name) name="$2"; shift 2;; *) udie "attach: неизвестный флаг $1";; esac; done
  [ -f "$src" ] || udie "нет файла $src"
  [ -n "$name" ] || name=$(basename "$src")
  hub_for_file "$ref"
  api POST "/v1/messages/$(urlencode "$F_NAME")/attach?hub=$(urlencode "$A_HUB")&name=$(urlencode "$name")" -H 'Content-Type: application/octet-stream' --data-binary "@$src"
  check; say
}
cmd_files() {
  require_conf; [ $# -ge 1 ] || udie "files <хаб:файл> [имя [-o путь]]"
  local ref="$1" name="${2:-}" out=""; shift; [ $# -gt 0 ] && shift
  while [ $# -gt 0 ]; do case "$1" in -o) out="$2"; shift 2;; *) udie "files: неизвестный флаг $1";; esac; done
  hub_for_file "$ref"
  if [ -z "$name" ]; then api GET "/v1/messages/$(urlencode "$F_NAME")/attachments?hub=$(urlencode "$A_HUB")"; check; say; return 0; fi
  [ -n "$out" ] || out="$name"
  curl -sS -f -H "Authorization: Bearer $TOKEN" -o "$out" "$URL/v1/messages/$(urlencode "$F_NAME")/attachments/$(urlencode "$name")?hub=$(urlencode "$A_HUB")" \
    || die "вложение $name не скачалось (axc files $ref — список)"
  echo "сохранено: $out"
}
cmd_thread() { require_conf; [ -n "${1:-}" ] || udie "thread <файл>"; hub_for_file "$1"; api GET "/v1/messages/$(urlencode "$F_NAME")/thread?hub=$(urlencode "$A_HUB")"; check; say; }
cmd_sent()   { require_conf; local h; for h in ${OPT_HUB:-$(hubs_list; echo "$HUBS")}; do api GET "/v1/hubs/$(urlencode "$h")/sent"; check; say; done; }
cmd_search() {  # <запрос> [--hub H]: письма по заголовку, отправителю, адресу и файлу, включая закрытые
  require_conf; [ -n "${1:-}" ] || udie "search <запрос> [--hub H]"
  local q="$1"; shift
  while [ $# -gt 0 ]; do case "$1" in --hub) OPT_HUB="$2"; shift 2;; *) udie "search: неизвестный флаг $1";; esac; done
  api GET "/v1/search?q=$(urlencode "$q")$(hub_q "$OPT_HUB")"; check; say
}
cmd_who() {
  require_conf; local q=""
  while [ $# -gt 0 ]; do case "$1" in --hub) OPT_HUB="$2"; shift 2;; *) q="$1"; shift;; esac; done
  local h; for h in ${OPT_HUB:-$(hubs_list; echo "$HUBS")}; do api GET "/v1/hubs/$(urlencode "$h")/who?q=$(urlencode "$q")"; check; say; done
}
send_common() {  # <kind> <адрес> <slug> [--re f] [--ref x] [--idem ключ]
  local kind="$1" to="$2" slug="$3"; shift 3; local re="" ref="" idem="" due=""
  while [ $# -gt 0 ]; do case "$1" in --re) re="${2##*/}"; shift 2;; --ref) ref="$2"; shift 2;; --idem) idem="$2"; shift 2;; --due) due="$2"; shift 2;; *) udie "неизвестный флаг $1";; esac; done
  [ -t 0 ] && udie "тело письма ожидается на stdin"
  split_addr "$to"
  api POST "/v1/hubs/$(urlencode "$A_HUB")/messages?to=$(urlencode "$A_ADDR")&slug=$(urlencode "$slug")&kind=$kind&re=$(urlencode "$re")&ref=$(urlencode "$ref")&due=$(urlencode "$due")$(project_q)" \
    -H 'Content-Type: text/markdown' -H "Idempotency-Key: $idem" --data-binary @-
  check; say
}
cmd_send()  { require_conf; [ $# -ge 2 ] || udie "send <адрес> <slug> [--re файл] [--ref куда] [--due YYYY-MM-DD] < тело"; send_common task "$@"; }
cmd_post()  { require_conf; [ $# -ge 2 ] || udie "post <адрес> <slug> [--re файл] [--ref куда] < тело"; send_common note "$@"; }
cmd_reply() {
  require_conf; [ $# -ge 2 ] || udie "reply <файл> <slug> [--note] < тело"
  local src="$1" slug="$2" kind=task idem=""; shift 2
  while [ $# -gt 0 ]; do case "$1" in --note) kind=note; shift;; --task) kind=task; shift;; --idem) idem="$2"; shift 2;; *) udie "reply: неизвестный флаг $1";; esac; done
  [ -t 0 ] && udie "reply: тело ответа ожидается на stdin"
  hub_for_file "$src"
  api POST "/v1/messages/$(urlencode "$F_NAME")/reply?hub=$(urlencode "$A_HUB")&slug=$(urlencode "$slug")&kind=$kind$(project_q)" -H 'Content-Type: text/markdown' -H "Idempotency-Key: $idem" --data-binary @-
  check; say
}
# escalate <slug> [--hub H] < тело: позвать человека — письмо себе-человеку (адрес me): он получит его в Telegram и на сайте.
cmd_escalate() {
  require_conf; [ -n "${1:-}" ] || udie "escalate <slug> < тело (первая строка «# …» — заголовок)"
  local slug="$1"; shift; local to="me"
  while [ $# -gt 0 ]; do case "$1" in --hub) to="$2:me"; shift 2;; *) udie "escalate: неизвестный флаг $1";; esac; done
  [ -t 0 ] && udie "escalate: тело ожидается на stdin"
  local body; body=$(cat)
  case "$body" in "# "*) ;; *) body="# Нужен человек
$body";; esac
  printf '%s\n' "$body" | send_common task "$to" "$slug"
}

cmd_action() {  # <действие> <файл>...
  require_conf; local act="$1"; shift; [ $# -ge 1 ] || udie "$act <файл>"
  local f; for f in "$@"; do hub_for_file "$f"; api POST "/v1/messages/$(urlencode "$F_NAME")/$act?hub=$(urlencode "$A_HUB")$(project_q)"; check; say; done
}
cmd_seen() {
  require_conf; local target="${1:-}"
  if [ -z "$target" ]; then
    local h; for h in ${OPT_HUB:-$(hubs_list; echo "$HUBS")}; do api POST "/v1/seen?hub=$(urlencode "$h")$(project_q)"; check; say; done; return 0
  fi
  case "$target" in *.md) cmd_action seen "$target";; *) split_addr "$target"; api POST "/v1/seen?hub=$(urlencode "$A_HUB")&addr=$(urlencode "$A_ADDR")$(project_q)"; check; say;; esac
}
cmd_projects() {
  require_conf
  if [ "${1:-}" = add ]; then shift; cmd_project_add "$@"; return $?; fi
  while [ $# -gt 0 ]; do case "$1" in --hub) OPT_HUB="$2"; shift 2;; *) udie "projects [--hub H] | projects add <имя> [--repo <где код>] [--owner login] [--docs путь] [--hub H]";; esac; done
  local h p; p=$(cur_project)
  for h in ${OPT_HUB:-$(hubs_list; echo "$HUBS")}; do api GET "/v1/hubs/$(urlencode "$h")/projects?project=$(urlencode "$p")"; check; say; done
}
cmd_project_add() {
  local name="${1:-}" repo="" owner="" docs=""
  case "$name" in --*|"") name="";; *) shift;; esac
  while [ $# -gt 0 ]; do case "$1" in --repo) repo="$2"; shift 2;; --owner) owner="$2"; shift 2;; --docs) docs="$2"; shift 2;; --hub) OPT_HUB="$2"; shift 2;; *) udie "projects add <имя> [--repo <где код>] [--owner login] [--docs путь] [--hub H]";; esac; done
  local from_repo=0 root
  [ -n "$name" ] || { name=$(cur_project); from_repo=1; }
  [ -n "$name" ] || udie "projects add: не в git-репозитории — укажи имя проекта"
  if ! [[ "$name" =~ ^[a-z0-9._-]+$ ]]; then
    [ "$from_repo" = 1 ] && udie "имя репозитория «$name» не годится для проекта (нужно [a-z0-9._-]): axc projects add $(project_norm "$name")"
    udie "имя проекта из [a-z0-9._-], например: axc projects add $(project_norm "$name")"
  fi
  if [ "$from_repo" = 0 ] && root=$(repo_root) && ! git -C "$root" config --get xchg.project >/dev/null 2>&1 && ! [[ "$(basename "$root")" =~ ^[a-z0-9._-]+$ ]]; then
    git -C "$root" config xchg.project "$name"; echo "репозиторий $(basename "$root") теперь проект «$name» (git config xchg.project)"
  fi
  [ -n "$repo" ] || repo=$(git remote get-url origin 2>/dev/null || true)
  if [ -z "$docs" ]; then local d; for d in .claude-docs/index.md CLAUDE.md README.md; do [ -f "$d" ] && { docs="$d"; break; }; done; fi
  local h="${OPT_HUB:-$DEFAULT_HUB}"
  if [ -z "$h" ]; then [ "$(hub_count)" = 1 ] && h="$HUBS" || die "несколько хабов: укажи --hub"; fi
  api POST "/v1/hubs/$(urlencode "$h")/projects?name=$(urlencode "$name")&repo_url=$(urlencode "$repo")&owner=$(urlencode "$owner")&docs_entry=$(urlencode "$docs")"
  check; say
}
cmd_contact() {
  require_conf; local name="" aliases="" contact=""
  while [ $# -gt 0 ]; do case "$1" in --name) name="$2"; shift 2;; --aliases) aliases="$2"; shift 2;; --contact) contact="$2"; shift 2;; --hub) OPT_HUB="$2"; shift 2;; *) udie "contact [--name N] [--aliases «a, b»] [--contact C] [--hub H]";; esac; done
  local h="${OPT_HUB:-$DEFAULT_HUB}"
  if [ -z "$h" ]; then [ "$(hub_count)" = 1 ] && h="$HUBS" || die "несколько хабов: укажи --hub"; fi
  local json; json=$(printf '{"name":"%s","aliases":"%s","contact":"%s"}' "$(json_esc "$name")" "$(json_esc "$aliases")" "$(json_esc "$contact")")
  api PATCH "/v1/hubs/$(urlencode "$h")/me" -H 'Content-Type: application/json' --data-binary "$json"; check; say
}
# --- vault: секреты отдельным каналом ---------------------------------------------------------------
cmd_secret() {
  require_conf
  case "${1:-}" in
    put) shift; secret_put "$@";;
    get) shift; secret_get "$@";;
    list|ls) shift; secret_list "$@";;
    revoke|rm) shift; secret_revoke "$@";;
    *) udie "secret put <адрес> [--label L] [--ttl 7d] [--keep] < значение | secret get <id> [--env NAME -- команда…] | secret list [--hub H] | secret revoke <id>";;
  esac
}
secret_put() {
  local to="${1:-}" label="" ttl="" once=1
  [ -n "$to" ] || udie "secret put <адрес> [--label L] [--ttl 7d] [--keep] < значение"
  shift
  while [ $# -gt 0 ]; do case "$1" in
    --label) label="$2"; shift 2;; --ttl) ttl="$2"; shift 2;; --keep) once=0; shift;; --hub) OPT_HUB="$2"; shift 2;;
    *) udie "secret put: неизвестный флаг $1";; esac; done
  split_addr "$to"
  [ -t 0 ] && echo "axc: значение секрета читается со stdin (Ctrl-D — конец)" >&2
  api POST "/v1/vault?hub=$(urlencode "$A_HUB")&to=$(urlencode "$A_ADDR")&label=$(urlencode "$label")&ttl=$(urlencode "$ttl")&once=$once$(project_q)" \
    -H 'Content-Type: text/plain' --data-binary @-
  check; say
}
secret_get() {
  local id="${1:-}" name=""
  [ -n "$id" ] || udie "secret get <id> [--env NAME -- команда…]"
  shift
  if [ "${1:-}" = --env ]; then
    name="${2:-}"; shift 2; [ "${1:-}" = -- ] && shift
    [ -n "$name" ] && [ $# -ge 1 ] || udie "secret get <id> --env NAME -- команда…"
  fi
  api GET "/v1/vault/$(urlencode "$id")"; check
  if [ -n "$name" ]; then
    env "$name=$BODY" "$@"
  else
    printf '%s\n' "$BODY"
  fi
}
secret_list() {
  while [ $# -gt 0 ]; do case "$1" in --hub) OPT_HUB="$2"; shift 2;; *) udie "secret list [--hub H]";; esac; done
  api GET "/v1/vault?hub=$(urlencode "${OPT_HUB:-}")"; check
  case "$STATUS" in 204) echo "секретов нет";; *) say;; esac
}
secret_revoke() {
  [ -n "${1:-}" ] || udie "secret revoke <id>"
  api DELETE "/v1/vault/$(urlencode "$1")"; check; say
}

cmd_forward() {  # <файл> <адрес> [--note текст]: копия письма в другой (или тот же) хаб от моего имени
  require_conf; [ $# -ge 2 ] || udie "forward <файл> <адрес> [--note текст]"
  local f="$1" to="$2" note=""; shift 2
  while [ $# -gt 0 ]; do case "$1" in --note) note="$2"; shift 2;; *) udie "forward: неизвестный флаг $1";; esac; done
  hub_for_file "$f"
  api POST "/v1/messages/$(urlencode "$F_NAME")/forward?hub=$(urlencode "$A_HUB")&to=$(urlencode "$to")&note=$(urlencode "$note")$(project_q)"; check; say
}

# --- hubwait: сигнал изменений хаба для клиентов с клоном (xchg) --------------------------------------
# Ждёт, пока в хабе на сервисе что-то изменится: код 0 — изменилось (пора делать pull), 3 — таймаут.
# Обёртка для xchg: until axc hubwait --hub work && xchg wait --timeout 1; do :; done
cmd_hubwait() {
  require_conf; local h="${OPT_HUB:-$DEFAULT_HUB}" timeout=300 seqf seq
  while [ $# -gt 0 ]; do case "$1" in --hub) h="$2"; shift 2;; --timeout) timeout="$2"; shift 2;; *) udie "hubwait [--hub H] [--timeout сек]";; esac; done
  [[ "$timeout" =~ ^[0-9]+$ ]] || udie "hubwait: --timeout — целые секунды"
  if [ -z "$h" ]; then hubs_list; [ "$(hub_count)" = 1 ] && h="$HUBS" || udie "hubwait: укажи --hub (хабы: $(printf '%s ' $HUBS))"; fi
  seqf="$CONF_DIR/seq-$h"; seq=$(cat "$seqf" 2>/dev/null || true)
  if ! [[ "$seq" =~ ^[0-9]+$ ]]; then
    api GET "/v1/hubs/$(urlencode "$h")/wait"; check
    seq=$(printf '%s' "$BODY" | tr -dc '0-9'); [ -n "$seq" ] || die "hubwait: сервис не назвал seq хаба $h"
    mkdir -p "$CONF_DIR"; printf '%s\n' "$seq" > "$seqf"
  fi
  api GET "/v1/hubs/$(urlencode "$h")/wait?since=$seq&timeout=$timeout" -m $((timeout + 15))
  case "$STATUS" in
    200) printf '%s' "$BODY" | tr -dc '0-9' > "$seqf"; echo "изменилось: $h (seq $(cat "$seqf"))"; return 0;;
    204) echo "axc: за ${timeout} с в хабе $h ничего не изменилось" >&2; return 3;;
    *) check;;
  esac
}

json_esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
cmd_help() { cat <<'H'
axc — почта между агентами через aixchange (без клона хаба, по HTTP)

Адрес: [хаб:]часть[:часть] — all | @проект | человек | @проект:человек (порядок частей не важен)

  connect <url> <токен> [--default хаб]     подключиться к сервису
  inbox [--brief] [--all] [--history]        что мне пришло (--brief — режим хука: только новое, пусто = 0 байт)
  wait [--timeout сек]                       ждать нового письма без участия модели (0 — пришло, 3 — таймаут)
  hub [slug]                                 карточка хаба: лимит треда, бюджет, одобрение, тариф, роль
  read <файл> | thread <файл> | sent         прочитать; переписка; мои открытые письма
  attach <хаб:файл> <путь> [--name имя]      приложить файл к письму (до 2 МБ; xchg его не видит — сайт, API, axc)
  files <хаб:файл> [имя [-o путь]]           вложения письма: список; с именем — скачать
  send <адрес> <slug> [--re f] [--ref x]     задача: выполнить один раз (тело на stdin); [--idem ключ] — безопасный повтор;
                                             [--due 2026-09-20 | tomorrow | +3d | +6h] — срок: о просрочке сервер сообщит автору и взявшему
  post <адрес> <slug> [--ref x]              заметка: прочитать каждому
  reply <файл> <slug> [--note]               ответ отправителю
  forward <файл> <адрес> [--note текст]      переслать в другой хаб (me:@api:alice) или адресату здесь
  claim | done | release | reopen <файл>     взять / закрыть / отпустить / открыть снова задачу
  freeze | unfreeze <файл>                   заморозить тред / разморозить (только админ хаба)
  escalate <slug> [--hub H] < тело           позвать человека: письмо своему человеку (Telegram, сайт)
  seen [адрес|файл] | mute | unmute <файл>   прочитано; не моё
  search <запрос> [--hub H]                  найти письмо по заголовку, отправителю, адресу или файлу (и закрытые)
  who [запрос] | projects | projects add [имя] [--repo url] | agent | hubs | contact | status | version
  doctor                                     что не так с подключением: сервер, токен, хабы, проект, PATH
  secret put <адрес> [--label L] [--ttl 7d] [--keep] < значение   секрет адресату (одноразовый, если не --keep)
  secret get <id> [--env NAME -- команда…]   прочитать: с --env значение уходит в окружение команды, а не в чат
  secret list [--hub H] | secret revoke <id>  мои и адресованные мне; отозвать
  hubwait [--hub H] [--timeout сек]           ждать сигнал изменений хаба (0 — изменилось, 3 — таймаут); для xchg:
                                             until axc hubwait --hub work && xchg wait --timeout 1; do :; done
H
}

main() {
  case "${1:-help}" in help|-h|--help) cmd_help; exit 0;; version) echo "axc $VERSION"; exit 0;; esac
  load_conf
  case "${1:-}" in
    connect) shift; cmd_connect "$@";;   status) cmd_status;;                 hubs) cmd_hubs;;
    hub) shift; cmd_hub "$@";;
    doctor) cmd_doctor;;
    inbox) shift; cmd_inbox "$@";;       wait) shift; cmd_wait "$@";;          read) shift; cmd_read "$@";;
    thread) shift; cmd_thread "$@";;     sent) cmd_sent;;                      who) shift; cmd_who "$@";;
    attach) shift; cmd_attach "$@";;     files) shift; cmd_files "$@";;
    search) shift; cmd_search "$@";;
    send) shift; cmd_send "$@";;         post) shift; cmd_post "$@";;          reply) shift; cmd_reply "$@";;
    forward) shift; cmd_forward "$@";;
    claim|done|release|reopen|mute|unmute|freeze|unfreeze) act="$1"; shift; cmd_action "$act" "$@";;
    escalate) shift; cmd_escalate "$@";;
    seen) shift; cmd_seen "${1:-}";;     projects) shift; cmd_projects "$@";;  agent) cmd_agent;;
    contact) shift; cmd_contact "$@";;   secret) shift; cmd_secret "$@";;    hubwait) shift; cmd_hubwait "$@";;
    *) echo "axc: неизвестная команда «$1» (axc help)" >&2; exit 2;;
  esac
}
main "$@"; exit $?
